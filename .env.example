# Configurações do Pipeline de Migração de Estoque
# Renomeie para .env para customizar caminhos locais

# Diretório base para arquivos de dados
APP_DATA_DIR=data

# Nomes dos arquivos de entrada
PDF_ENTRADA=data/catalogo_fornecedor.pdf
EXCEL_SISTEMA=data/produtos_sistema.xlsx

# Parâmetros de execução do Robô RPA
TEMPO_FILTRO_SEGUNDOS=2.0
QTD_SHIFT_TABS_RETORNO=5
TAMANHO_LOTE_PADRAO=20
PAUSA_ENTRE_COMANDOS=0.12
